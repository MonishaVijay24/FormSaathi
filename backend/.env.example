# ---- App ----
APP_ENV=dev                      # dev | prod  (/api/health/gemini only exists in dev)
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Session / cookie ----
COOKIE_NAME=fs_session
COOKIE_SECURE=false              # true in production (HTTPS)
COOKIE_SAMESITE=lax              # use "none" + secure=true if frontend is on another site
SESSION_IDLE_MINUTES=15          # idle timeout (sliding)
SESSION_WARN_SECONDS=120         # frontend shows "Extend time" when remaining <= this
SESSION_MAX_HOURS=4              # absolute cap

# ---- Gemini (backend only, never expose to the browser) ----
GEMINI_API_KEY=
ENCRYPTION_KEY=                   # Required: base64-encoded 32-byte random key; never commit the real key
GEMINI_MODEL=gemini-2.5-flash    # change if your key has a newer vision model
MOCK_AI=true                     # Generic gateway calls only; no applicant data or uploads go to Gemini

# ---- Speech ----
TTS_ENABLED=false                # Cloud TTS is disabled; frontend uses browser speechSynthesis
AUDIO_TTL_MINUTES=60

# ---- Storage / limits ----
DB_PATH=./storage/sessions.db
TTS_CACHE_DIR=./storage/tts
MAX_UPLOAD_MB=8
